# GTU-NAV Ortam Değişkenleri (Şartname Uyumlu Örnek Dosya)
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Veritabanı Bağlantısı (Varsayılan: Yerel SQLite, Production'da PostgreSQL'e çevrilebilir)
DATABASE_URL=sqlite:///./gtu_nav.db

# Admin & Demo Anahtarı (Jüri ve Geliştirici Modu)
ADMIN_SECRET_KEY=gtunav_admin_secret_2026
JWT_SECRET_KEY=gtunav_jwt_secret_key_2026

# Yerel CPU Yapay Zekâ Model Ayarları (Türkçe Ticket NLP Triyaj & Aciliyet Modeli)
AI_MODEL_PATH=weights/ticket_ai_model.joblib
